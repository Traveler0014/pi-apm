{
  "name": "pi-apm",
  "version": "0.1.0",
  "description": "AgentPM (apm) integration for pi: claims, handover context, and a run-end side-run that keeps the work ledger honest.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "agentpm",
    "apm",
    "agents",
    "task-ledger"
  ],
  "pi": {
    "extensions": [
      "./pi-apm/index.ts"
    ],
    "contextBudget": "~250 tokens"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Traveler0014/pi-apm.git"
  },
  "homepage": "https://github.com/Traveler0014/pi-apm#readme",
  "bugs": {
    "url": "https://github.com/Traveler0014/pi-apm/issues"
  },
  "scripts": {
    "test": "vitest run",
    "test:rust": "cargo test --all-targets",
    "test:stress": "bash scripts/stress.sh 10",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test --all-targets && tsc -p tsconfig.json && vitest run",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:test": "vitest run ui",
    "ui:typecheck": "tsc -p ui/tsconfig.json",
    "ui:browser": "node scripts/ui-browser-check.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.10.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "typebox": "^1.4.7",
    "typescript": "^5.7.0",
    "vite": "^6.4.6",
    "vitest": "^2.1.0"
  }
}
